{
  "name": "pairs",
  "version": "1.0.1",
  "description": "A remake of the classic card game Pairs, written in TypeScript",
  "keywords": [
    "pairs",
    "memory",
    "card-game",
    "game",
    "typescript",
    "canvas"
  ],
  "license": "ISC",
  "author": "Adrian Eyre",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianeyre/pairs.git"
  },
  "bugs": {
    "url": "https://github.com/adrianeyre/pairs/issues"
  },
  "homepage": "https://pairs.adrianeyre.co.uk/",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,js,json,md}\" \"index.html\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,js,json,md}\" \"index.html\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
